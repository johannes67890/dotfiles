// Layout and framework.png adapted from github.com/luyu-wu/Config (MIT, Copyright 2026 Luyu)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/framework.png",
    "width": 36,
    "height": 24,
    "preserveAspectRatio": true,
    "padding": { "top": 1, "left": 4, "right": 6 }
  },
  "display": {
    "separator": " :: "
  },
  "modules": [
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "┌─────────── \u001b[1m    Hardware    \u001b[0m ───────────┐" },
    { "type": "custom", "format": "" },
    { "type": "host", "key": "   ", "format": "{vendor} {name:13}" },
    { "type": "cpu", "key": "   ", "format": "{name}" },
    { "type": "gpu", "key": "   ", "format": "{vendor} {name}" },
    { "type": "memory", "key": "   " },
    { "type": "swap", "key": "   " },
    { "type": "disk", "key": "   ", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "monitor", "key": "   ", "format": "{width}x{height} @ {refresh-rate} Hz, {inch}\"" },
    { "type": "battery", "key": "   ", "format": "{capacity} [{status}]" },
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "├─────────── \u001b[1m    Software    \u001b[0m ───────────┤" },
    { "type": "custom", "format": "" },
    { "type": "os", "key": "   " },
    { "type": "kernel", "key": "   " },
    { "type": "de", "key": "   " },
    { "type": "wm", "key": "   " },
    { "type": "shell", "key": "   " },
    { "type": "terminal", "key": "   " },
    { "type": "packages", "key": "   ", "format": "{all} ({nix-system} system, {nix-user} user)" },
    { "type": "uptime", "key": "   " },
    { "type": "datetime", "key": "   " },
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "└────────────────────────────────────────┘" }
  ]
}
